# ATECH environment configuration
# Kopyahin ito sa `.env` at palitan ang mga value.

PORT=3000
HOST=0.0.0.0

# Admin password — huwag gamitin ang default sa production.
ADMIN_PASSWORD=palitan-mo-ito

# Random string para sa admin session cookie.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=palitan-mo-ito-ng-random-string

# Maximum size ng isang installer file (MB).
MAX_UPLOAD_MB=2048

# Maximum size ng cover image (MB).
MAX_COVER_MB=8

# Mag-seed ng sample installer entries kapag walang laman ang database.
# Gawing false sa production kung ayaw mo ng demo entries.
SEED_DEMO=true
